# --- LLM provider ---------------------------------------------------------
# The model chain lives in config/llm.yaml. Claude is the default provider.
ANTHROPIC_API_KEY=

# --- Payments -------------------------------------------------------------
# "mock" (default) uses the built-in Stripe-like payment simulator.
# "stripe" uses Stripe TEST mode (real API, fake money). Run `support seed-stripe` once after `support init-db`.
PAYMENTS_BACKEND=mock
STRIPE_API_KEY=

# --- Human-in-the-loop push notifications (https://ntfy.sh) ---------------
# Install the ntfy app on your phone and subscribe to NTFY_TOPIC.
# Approve/Reject buttons post back to NTFY_REPLY_TOPIC, which `support approvals listen` watches.
# Topic names on the public server are effectively passwords: make them long and random.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_REPLY_TOPIC=
# Optional access token for a protected/self-hosted ntfy server.
NTFY_TOKEN=
# HMAC secret used to sign Approve/Reject buttons so a stranger posting to the reply topic can't approve refunds.
APPROVAL_SIGNING_SECRET=
